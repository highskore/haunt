 "css": {
  "ui": {
   ".bar": {
    "grid-column": "2 / 4",
    "height": 2,
    "background": "#2a2a2a",
    "position": "relative",
    "margin-top": 4
   },
   ".bar b": {
    "position": "absolute",
    "inset": "0 auto 0 0",
    "background": "#e8e8e8"
   },
   ".body": {
    "flex": 1,
    "display": "flex",
    "min-height": 0
   },
   ".dot": {
    "width": 6,
    "height": 6,
    "border-radius": "50%",
    "background": "#e8e8e8",
    "display": "inline-block"
   },
   ".dot.hollow": {
    "background": "transparent",
    "border": "1px solid #8a8a8a"
   },
   ".grow": {
    "flex": 1
   },
   ".kbd": {
    "font": "11px var(--ui)",
    "color": "#8a8a8a",
    "border": "1px solid #2c2c2c",
    "border-radius": 5,
    "padding": [
     0,
     5
    ],
    "line-height": 17
   },
   ".label": {
    "font-size": 10,
    "letter-spacing": 0.08,
    "color": "#6b6b6b",
    "text-transform": "uppercase",
    "padding": [
     10,
     14,
     4
    ]
   },
   ".lights": {
    "display": "flex",
    "gap": 8
   },
   ".lights i": {
    "width": 12,
    "height": 12,
    "border-radius": "50%",
    "background": "#3a3a3a",
    "display": "block"
   },
   ".muted": {
    "color": "#6b6b6b"
   },
   ".pane": {
    "flex": 1,
    "padding": [
     14,
     18
    ],
    "font": "12.5px/1.65 var(--mono)",
    "color": "#cfcfcf",
    "overflow": "hidden"
   },
   ".pane .dim": {
    "color": "#6f6f6f"
   },
   ".pane .hi": {
    "color": "#ffffff"
   },
   ".pane .ok": {
    "color": "#9a9a9a"
   },
   ".side": {
    "width": 250,
    "flex": "none",
    "border-right": "1px solid #1c1c1c",
    "display": "flex",
    "flex-direction": "column",
    "min-height": 0,
    "background": "#0e0e0e"
   },
   ".sub": {
    "grid-column": "2 / 4",
    "display": "flex",
    "gap": 8,
    "justify-content": "space-between",
    "color": "#8a8a8a",
    "font-size": 10.5,
    "margin-top": 2,
    "white-space": "nowrap"
   },
   ".sub span:first-child": {
    "overflow": "hidden",
    "text-overflow": "ellipsis"
   },
   ".tab": {
    "padding": [
     8,
     14
    ],
    "display": "grid",
    "grid-template-columns": "18px 1fr auto",
    "gap": [
     2,
     9
    ],
    "align-items": "center",
    "font-size": 12.5
   },
   ".tab .ic": {
    "width": 18,
    "height": 18,
    "border-radius": 5,
    "display": "grid",
    "place-items": "center",
    "font": "10px var(--mono)",
    "color": "#9a9a9a",
    "background": "#1b1b1b"
   },
   ".tab .ic.claude": {
    "background": "transparent"
   },
   ".tab .meta": {
    "grid-column": "2 / 4",
    "color": "#6f6f6f",
    "font-size": 11,
    "white-space": "nowrap",
    "overflow": "hidden",
    "text-overflow": "ellipsis"
   },
   ".tab .name": {
    "color": "#e8e8e8",
    "white-space": "nowrap",
    "overflow": "hidden",
    "text-overflow": "ellipsis"
